{% extends "base.jinja2" %}

{% block content %}
<div class="mb-8">
    <div class="flex items-baseline space-x-3">
        <h1 class="text-4xl font-extrabold text-gray-900 dark:text-white">{{ location.city }}</h1>
        <span class="text-2xl text-gray-500 dark:text-gray-400 font-medium">{{ location.country }}</span>
    </div>
    <p class="text-gray-500 dark:text-gray-400 mt-2 font-mono text-sm">
        {{ location.latitude|round(4) }}, {{ location.longitude|round(4) }}
    </p>
</div>

<div class="flex flex-col space-y-6 max-w-2xl">
    {% for snapshot in weather_snapshots %}
        {% set desc_icon = WEATHER_CODES.get(snapshot.weather_code, ("Unknown", "cloudy")) %}
        {% set description = desc_icon[0] %}
        {% set icon = desc_icon[1] %}
        
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-shadow duration-300">
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-5 py-3 flex justify-between items-center text-white">
                <span class="text-sm font-medium opacity-90">{{ snapshot.created_at.strftime('%b %d, %H:%M') }}</span>
                <div class="w-14 h-14 flex items-center justify-center">
                    {% if icon == 'sunny' %}
                    <svg class="w-10 h-10 text-yellow-300" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.697 7.757a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 00-1.061 1.06l1.59 1.591z" />
                    </svg>
                    {% elif icon == 'cloudy' %}
                    <svg class="w-10 h-10 text-gray-200" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M4.5 9.75a6 6 0 0111.573-2.226 3.75 3.75 0 014.133 4.303A4.5 4.5 0 0118 20.25H6.75a5.25 5.25 0 01-2.23-10.004 6.072 6.072 0 01-.02-.496z" />
                    </svg>
                    {% elif icon == 'rain' or icon == 'drizzle' %}
                    <svg class="w-10 h-10 text-blue-200" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M4.5 9.75a6 6 0 0111.573-2.226 3.75 3.75 0 014.133 4.303A4.5 4.5 0 0118 20.25H6.75a5.25 5.25 0 01-2.23-10.004 6.072 6.072 0 01-.02-.496z" />
                        <path d="M8 16l-1 4M12 16l-1 4M16 16l-1 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    {% elif icon == 'snow' %}
                    <svg class="w-10 h-10 text-blue-100" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M4.5 9.75a6 6 0 0111.573-2.226 3.75 3.75 0 014.133 4.303A4.5 4.5 0 0118 20.25H6.75a5.25 5.25 0 01-2.23-10.004 6.072 6.072 0 01-.02-.496z" />
                        <circle cx="8" cy="18" r="1" fill="white" />
                        <circle cx="12" cy="17" r="1" fill="white" />
                        <circle cx="16" cy="18" r="1" fill="white" />
                    </svg>
                    {% elif icon == 'storm' %}
                    <svg class="w-10 h-10 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M4.5 9.75a6 6 0 0111.573-2.226 3.75 3.75 0 014.133 4.303A4.5 4.5 0 0118 20.25H6.75a5.25 5.25 0 01-2.23-10.004 6.072 6.072 0 01-.02-.496z" />
                        <path d="M13 12l-2 5h3l-2 5" stroke="yellow" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                    </svg>
                    {% elif icon == 'fog' %}
                    <svg class="w-10 h-10 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-width="2" d="M4 8h16M4 12h16M4 16h12" />
                    </svg>
                    {% else %}
                    <svg class="w-10 h-10 text-gray-200" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M4.5 9.75a6 6 0 0111.573-2.226 3.75 3.75 0 014.133 4.303A4.5 4.5 0 0118 20.25H6.75a5.25 5.25 0 01-2.23-10.004 6.072 6.072 0 01-.02-.496z" />
                    </svg>
                    {% endif %}
                </div>
            </div>
            
            <div class="p-5">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <span class="text-3xl font-bold text-gray-900 dark:text-white">{{ snapshot.temperature_2m|round }}°</span>
                        <span class="text-gray-500 dark:text-gray-400 text-lg ml-1">C</span>
                    </div>
                    <div class="text-right">
                        <p class="text-gray-700 dark:text-gray-300 font-semibold text-sm">{{ description }}</p>
                        <p class="text-gray-500 dark:text-gray-400 text-xs">Feels {{ snapshot.apparent_temperature|round }}°C</p>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-3 pt-4 border-t border-gray-100 dark:border-gray-700">
                    <div class="text-center">
                        <p class="text-gray-400 text-[10px] uppercase tracking-wider mb-1">Humidity</p>
                        <p class="text-gray-900 dark:text-white font-bold text-xs">{{ snapshot.relative_humidity_2m }}%</p>
                    </div>
                    <div class="text-center border-x border-gray-100 dark:border-gray-700">
                        <p class="text-gray-400 text-[10px] uppercase tracking-wider mb-1">Wind</p>
                        <p class="text-gray-900 dark:text-white font-bold text-xs">{{ snapshot.wind_speed_10m|round }} <span class="text-[9px] font-normal">km/h</span></p>
                    </div>
                    <div class="text-center">
                        <p class="text-gray-400 text-[10px] uppercase tracking-wider mb-1">Pressure</p>
                        <p class="text-gray-900 dark:text-white font-bold text-xs">{{ snapshot.surface_pressure|round }} <span class="text-[9px] font-normal">hPa</span></p>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-span-full py-12 text-center bg-white dark:bg-gray-800 rounded-xl border-2 border-dashed border-gray-200 dark:border-gray-700">
            <svg class="w-12 h-12 mx-auto text-gray-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h3 class="text-lg font-medium text-gray-900 dark:text-white">No history yet</h3>
            <p class="text-gray-500 dark:text-gray-400">Weather data for this location will appear here once tracked.</p>
        </div>
    {% endfor %}
</div>
{% endblock %}