{% extends "base.jinja2" %}

{% block content %}
<div class="max-w-md mx-auto">
    {% if messages %}
    <div class="mb-4">
        {% for message in messages %}
            {% if message.tags != 'success' %}
            <div class="p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400" role="alert">
                {{ message }}
            </div>
            {% endif %}
        {% endfor %}
    </div>
    {% endif %}

    <div class="bg-white dark:bg-gray-800 p-8 rounded-lg shadow-md">
        <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">Track New Location</h2>

    <form action="{{ url('create_location') }}" method="POST" class="space-y-4">
        {# Django requires the CSRF token even in Jinja2 #}
        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
        
        <div>
            <label for="find_method" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Search Method</label>
            <select name="find_method" id="find_method" onchange="toggleFields()" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                <option value="name">By Name</option>
                <option value="coordinates">By Coordinates</option>
            </select>
        </div>

        <div id="fields_name" class="space-y-4">
            <div>
                <input type="text" name="city_name" placeholder="City" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">
            </div>
            <div>
                <input type="text" name="country_name" placeholder="Country" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">
            </div>
        </div>

        <div id="fields_coordinates" class="space-y-4 hidden">
            <div>
                <input type="number" step="any" min="-90" max="90" name="latitude" placeholder="Latitude" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">
            </div>
            <div>
                <input type="number" step="any" min="-180" max="180" name="longitude" placeholder="Longitude" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">
            </div>
        </div>

        <button type="submit" class="w-full text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">Save Location</button>
    </form>
</div>

<script>
function toggleFields() {
    const method = document.getElementById('find_method').value;
    const nameFields = document.getElementById('fields_name');
    const coordFields = document.getElementById('fields_coordinates');
    
    if (method === 'name') {
        nameFields.classList.remove('hidden');
        coordFields.classList.add('hidden');
    } else {
        nameFields.classList.add('hidden');
        coordFields.classList.remove('hidden');
    }
}
</script>
{% endblock %}