<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {% for loc in locations %}
        <div class="bg-white rounded-lg shadow-lg dark:bg-gray-800 overflow-hidden">
            <div
                hx-get="{{ url('get_weather_data') }}"
                hx-trigger="load"
                hx-vals='{"id": "{{ loc.id }}"}'
                hx-target="#weather-data-{{ loc.id }}"
                hx-swap="innerHTML"
            >
                <div id="weather-data-{{ loc.id }}">
                    <div class="flex justify-center py-10">
                        <svg class="animate-spin h-8 w-8 text-blue-500" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-span-full py-12 text-center bg-gray-50 dark:bg-gray-900/50 rounded-xl border-2 border-dashed border-gray-200 dark:border-gray-700">
            <p class="text-gray-500 dark:text-gray-400">No locations tracked yet.</p>
        </div>
    {% endfor %}
</div>