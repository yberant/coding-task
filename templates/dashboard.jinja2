{% extends "base.jinja2" %}

{% block title %}Dashboard - Weather Dashboard{% endblock %}

{% block content %}
<div class="py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Dashboard</h1>
    </div>

    {% if error_message %}
    <div class="p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400" role="alert">
        {{ error_message }}
    </div>
    {% endif %}

    {% if weather %}
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <!-- Current Location Weather Widget -->
        <div class="bg-white rounded-lg shadow-lg dark:bg-gray-800 overflow-hidden">
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-white text-lg font-semibold">{{ weather.city }}</h3>
                        <p class="text-blue-100 text-sm">{{ weather.country }}</p>
                    </div>
                    <div class="w-16 h-16 flex items-center justify-center">
                        {% if weather.icon == 'sunny' %}
                        <svg class="w-12 h-12 text-yellow-300" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.697 7.757a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 00-1.061 1.06l1.59 1.591z"/>
                        </svg>
                        {% elif weather.icon == 'cloudy' %}
                        <svg class="w-12 h-12 text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M4.5 9.75a6 6 0 0111.573-2.226 3.75 3.75 0 014.133 4.303A4.5 4.5 0 0118 20.25H6.75a5.25 5.25 0 01-2.23-10.004 6.072 6.072 0 01-.02-.496z"/>
                        </svg>
                        {% elif weather.icon == 'rain' or weather.icon == 'drizzle' %}
                        <svg class="w-12 h-12 text-blue-300" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M4.5 9.75a6 6 0 0111.573-2.226 3.75 3.75 0 014.133 4.303A4.5 4.5 0 0118 20.25H6.75a5.25 5.25 0 01-2.23-10.004 6.072 6.072 0 01-.02-.496z"/>
                            <path d="M8 16l-1 4M12 16l-1 4M16 16l-1 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        {% elif weather.icon == 'snow' %}
                        <svg class="w-12 h-12 text-blue-100" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M4.5 9.75a6 6 0 0111.573-2.226 3.75 3.75 0 014.133 4.303A4.5 4.5 0 0118 20.25H6.75a5.25 5.25 0 01-2.23-10.004 6.072 6.072 0 01-.02-.496z"/>
                            <circle cx="8" cy="18" r="1" fill="white"/><circle cx="12" cy="17" r="1" fill="white"/><circle cx="16" cy="18" r="1" fill="white"/>
                        </svg>
                        {% elif weather.icon == 'storm' %}
                        <svg class="w-12 h-12 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M4.5 9.75a6 6 0 0111.573-2.226 3.75 3.75 0 014.133 4.303A4.5 4.5 0 0118 20.25H6.75a5.25 5.25 0 01-2.23-10.004 6.072 6.072 0 01-.02-.496z"/>
                            <path d="M13 12l-2 5h3l-2 5" stroke="yellow" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                        </svg>
                        {% elif weather.icon == 'fog' %}
                        <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-width="2" d="M4 8h16M4 12h16M4 16h12"/>
                        </svg>
                        {% else %}
                        <svg class="w-12 h-12 text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M4.5 9.75a6 6 0 0111.573-2.226 3.75 3.75 0 014.133 4.303A4.5 4.5 0 0118 20.25H6.75a5.25 5.25 0 01-2.23-10.004 6.072 6.072 0 01-.02-.496z"/>
                        </svg>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="px-6 py-4">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <span class="text-5xl font-bold text-gray-900 dark:text-white">{{ weather.temperature }}°</span>
                        <span class="text-gray-500 dark:text-gray-400 text-lg">C</span>
                    </div>
                    <div class="text-right">
                        <p class="text-gray-700 dark:text-gray-300 font-medium">{{ weather.description }}</p>
                        <p class="text-gray-500 dark:text-gray-400 text-sm">Feels like {{ weather.feels_like }}°C</p>
                    </div>
                </div>
                <div class="grid grid-cols-3 gap-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                    <div class="text-center">
                        <svg class="w-6 h-6 mx-auto text-gray-400 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
                        </svg>
                        <p class="text-gray-500 dark:text-gray-400 text-xs">Humidity</p>
                        <p class="text-gray-900 dark:text-white font-semibold">{{ weather.humidity }}%</p>
                    </div>
                    <div class="text-center">
                        <svg class="w-6 h-6 mx-auto text-gray-400 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                        <p class="text-gray-500 dark:text-gray-400 text-xs">Wind</p>
                        <p class="text-gray-900 dark:text-white font-semibold">{{ weather.wind_speed }} km/h</p>
                    </div>
                    <div class="text-center">
                        <svg class="w-6 h-6 mx-auto text-gray-400 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                        <p class="text-gray-500 dark:text-gray-400 text-xs">Pressure</p>
                        <p class="text-gray-900 dark:text-white font-semibold">{{ weather.pressure }} hPa</p>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 dark:bg-gray-700 px-6 py-3">
                <p class="text-xs text-gray-500 dark:text-gray-400 text-center">
                    {% if weather.location_source == 'ip' %}
                    Current location (based on IP)
                    {% else %}
                    Default location (IP detection unavailable)
                    {% endif %}
                </p>
            </div>
        </div>
    </div>
    {% else %}
    {% if not error_message %}
    <div class="flex flex-col items-center justify-center py-16">
        <div class="text-center">
            <svg class="mx-auto mb-4 w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            <h3 class="mb-2 text-xl font-semibold text-gray-900 dark:text-white">No widgets added</h3>
            <p class="text-gray-500 dark:text-gray-400 mb-4">Get started by adding your first weather widget to track conditions for your favorite locations.</p>
        </div>
    </div>
    {% endif %}
    {% endif %}
</div>
{% endblock %}
